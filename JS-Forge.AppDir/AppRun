is_runnable_script() {
	local file="$1"

	[[ -f "$file" ]] || return 1

	case "$file" in
	*".$package_manager" | *.sh) return 0 ;;
	*) return 1 ;;
	esac
}

run_selected_script() {
    local full_path="$1"
    local selection
    local no_pause="0"

    selection="$(basename "$full_path")"
    # Bundled shell scripts are read-only: use Bash without chmod.

    if grep -Eq '^[[:space:]]*jsf_no_pause="1"' "$full_path" 2>/dev/null; then
        no_pause="1"
    fi

    if [ "$gui_flag" = "1" ]; then
        if [ "$no_pause" = "1" ]; then
            jsf_launch_terminal_script_nopause "$full_path"
        else
            jsf_launch_terminal_script "$full_path"
        fi
    else
        sleep .3
        echo ""
        bash -- "$full_path"

        if [ "$no_pause" != "1" ]; then
            divider
            entertocontinue | center
        fi
    fi
}

# Virtual overlay: physical collection names never appear as menu levels.
jsf_lcp_relative_path() {
    case "$1" in
        @lcp) printf '%s' '' ;;
        @lcp/*) printf '%s' "${1#@lcp/}" ;;
        *) return 1 ;;
    esac
}

jsf_lcp_sources() {
    local rel
    rel="$(jsf_lcp_relative_path "$1")" || return 1
    jsf_lcp_source_dirs=("$bundled_script_root/headless${rel:+/$rel}")
    if [ "${desktop_capable:-0}" = "1" ]; then
        jsf_lcp_source_dirs+=("$bundled_script_root/gui${rel:+/$rel}")
    fi
}

jsf_browser_entries() {
    local node="$1" scan_dir entry name rel ext_key
    local source_dirs=() sorted_dirs=() sorted_files=() jsf_lcp_source_dirs=()
    local -A seen_dirs=() script_paths=()
    browser_labels=(); browser_targets=(); browser_kinds=(); browser_scan_dirs=()
    browser_script_count=0; browser_content_count=0
    if [ "$node" = "@main" ]; then
        browser_labels+=("📁 Linux Control Panel")
        browser_targets+=("@lcp"); browser_kinds+=("directory")
        if [ "${gitengine_ext_loaded:-0}" = "1" ]; then
            browser_labels+=("📁 GitEngine Scripts")
            browser_targets+=("$app_script_folder_loc"); browser_kinds+=("directory")
        fi
        for ext_key in "${ext_menu_order[@]}"; do
            [ -n "${ext_menu_labels[$ext_key]}" ] || continue
            browser_labels+=("${ext_menu_labels[$ext_key]}")
            browser_targets+=("$ext_key"); browser_kinds+=("extension")
        done
        browser_labels+=("🪪 About $app_name" "🚪 Exit $app_name")
        browser_targets+=("@about" "@exit"); browser_kinds+=("action" "action")
        return 0
    fi
    case "$node" in
        @lcp|@lcp/*)
            rel="$(jsf_lcp_relative_path "$node")"
            jsf_lcp_sources "$node"
            source_dirs=("${jsf_lcp_source_dirs[@]}") ;;
        *) source_dirs=("$node") ;;
    esac
    browser_scan_dirs=("${source_dirs[@]}")
    for scan_dir in "${source_dirs[@]}"; do
        [ -d "$scan_dir" ] || continue
        for entry in "$scan_dir"/*; do
            [ -e "$entry" ] || continue
            name="${entry##*/}"
            [[ "$name" == *$'\n'* ]] && continue
            if [ -d "$entry" ]; then
                seen_dirs["$name"]=1
            elif is_runnable_script "$entry"; then
                script_paths["$name"]="$entry"
            fi
        done
    done
    if [ "${#seen_dirs[@]}" -gt 0 ]; then
        mapfile -t sorted_dirs < <(printf '%s\n' "${!seen_dirs[@]}" | LC_ALL=C sort)
    fi
    if [ "${#script_paths[@]}" -gt 0 ]; then
        mapfile -t sorted_files < <(printf '%s\n' "${!script_paths[@]}" | LC_ALL=C sort)
    fi
    for name in "${sorted_dirs[@]}"; do
        browser_labels+=("📁 $name")
        case "$node" in
            @lcp|@lcp/*) browser_targets+=("@lcp/${rel:+$rel/}$name") ;;
            *) browser_targets+=("$node/$name") ;;
        esac
        browser_kinds+=("directory")
    done
    for name in "${sorted_files[@]}"; do
        browser_labels+=("📄 $name"); browser_targets+=("${script_paths[$name]}")
        browser_kinds+=("script"); ((browser_script_count+=1))
    done
    browser_content_count=${#browser_labels[@]}
    if [ "${tui_flag:-0}" = "1" ] && [ "$browser_script_count" -gt 0 ]; then
        browser_labels+=("View Action's Source Code")
        browser_targets+=("@source"); browser_kinds+=("action")
    fi
    if [ "${gui_flag:-0}" != "1" ]; then
    browser_labels+=("<- Back"); browser_targets+=("@back"); browser_kinds+=("action")
    fi
    return 0
}

jsf_browser_title() {
    local node="$1" rel
    case "$node" in
        @main) printf '%s\n' 'Main Menu' ;;
        @lcp) printf '%s\n' 'Linux Control Panel' ;;
        @lcp/*) rel="${node#@lcp/}"; printf 'Linux Control Panel -> %s\n' "${rel//\// -> }" ;;
        "$app_script_folder_loc") printf '%s\n' 'GitEngine Scripts' ;;
        "$app_script_folder_loc"/*)
            rel="${node#"$app_script_folder_loc/"}"
            printf 'GitEngine Scripts -> %s\n' "${rel//\// -> }" ;;
        *) printf '%s\n' "$node" ;;
    esac
}

jsf_pick_browser_row() {
    local title="$1" cancel_label="$2" output_name="$3"
    local chosen_label chosen_index row
    local gui_rows=()
    if [ "$gui_flag" = "1" ]; then
        for ((row=0; row<${#browser_labels[@]}; row++)); do
            gui_rows+=("$row" "${browser_labels[$row]}")
        done
        chosen_index=$(zenity --list --title="$app_name" --text="$title" \
            --column="ID" --column="Options" --hide-column=1 --print-column=1 \
            "${gui_rows[@]}" $default_mainmenu_gui_dimensions \
            --ok-label="Select" --cancel-label="$cancel_label") || return 1
        [[ "$chosen_index" =~ ^[0-9]+$ ]] || return 1
        [ "$chosen_index" -lt "${#browser_labels[@]}" ] || return 1
    else
        cursor_menu 'Select a menu option:' chosen_label "${browser_labels[@]}" || return 1
        chosen_index=""
        for ((row=0; row<${#browser_labels[@]}; row++)); do
            if [ "$chosen_label" = "${browser_labels[$row]}" ]; then
                chosen_index=$row; break
            fi
        done
        [ -n "$chosen_index" ] || return 1
    fi
    printf -v "$output_name" '%s' "$chosen_index"
}

jsf_browser_empty_notice() {
    local node="$1" path message missing=1 paths_text=""
    for path in "${browser_scan_dirs[@]}"; do
        [ -d "$path" ] && missing=0
        printf -v paths_text '%s\n%s' "$paths_text" "$path"
    done
    if [ "$missing" = "1" ]; then
        message="Script directory not found for $(jsf_browser_title "$node")."
    else
        message="No immediate subfolders or compatible scripts found for $(jsf_browser_title "$node")."
    fi
    message+=$'\n\nChecked directories:'"$paths_text"
    message+=$'\n\nAccepted script suffixes: .sh and .'"$package_manager"
    message+=$'\nBundle root: '"$bundled_script_root"
    message+=$'\nLauncher directory: '"${JSF_EXEC_DIR:-unknown}"
    message+=$'\nAPPDIR: '"${APPDIR:-unset}"
    message+=$'\nAPPDIR at launch: '"${JSF_LAUNCH_APPDIR:-unset}"
    if [ "$gui_flag" = "1" ]; then
        zenity --info --title="$app_name: Script Browser" --text="$message" $default_messagebox_gui_dimensions
    else
        printf '\n%s\n' "$message"; entertocontinue
    fi
}

view_script_source() {
    local node="$1" row selected_row
    local browser_labels=() browser_targets=() browser_kinds=() browser_scan_dirs=()
    local browser_script_count=0 browser_content_count=0 source_labels=() source_targets=()
    jsf_browser_entries "$node"
    for ((row=0; row<${#browser_kinds[@]}; row++)); do
        [ "${browser_kinds[$row]}" = "script" ] || continue
        source_labels+=("${browser_labels[$row]}"); source_targets+=("${browser_targets[$row]}")
    done
    [ "${#source_labels[@]}" -gt 0 ] || return 0
    if [ "${gui_flag:-0}" != "1" ]; then
    source_labels+=("<- Back"); source_targets+=("@back")
    fi
    browser_labels=("${source_labels[@]}")
    jsf_pick_browser_row "$(jsf_browser_title "$node") -> View Source" '<- Back' selected_row || return
    [ "${source_targets[$selected_row]}" = "@back" ] && return
    case "${source_targets[$selected_row]}" in
        "$bundled_script_root"/*) nano --view "${source_targets[$selected_row]}" ;;
        *) nano "${source_targets[$selected_row]}" ;;
    esac
}

browse_menu() {
    local node="$1" root="${2:-@main}" selected_row target kind title cancel_label
    local browser_labels=() browser_targets=() browser_kinds=() browser_scan_dirs=()
    local browser_script_count=0 browser_content_count=0
    while true; do
        jsf_browser_entries "$node"
        title="$(jsf_browser_title "$node")"
        if [ "$node" != "@main" ] && [ "$browser_content_count" -eq 0 ]; then
            jsf_browser_empty_notice "$node"; return
        fi
        cancel_label='<- Back'
        [ "$node" = "@main" ] && cancel_label='Exit'
        if [ "$tui_flag" = "1" ]; then
            clear; jsforge_banner
            echo "$app_name $app_ver_major.$app_ver_minor.$app_ver_build $app_ver_stage" | center
            printf '%s\n' "$title" | center; divider
        fi
        if ! jsf_pick_browser_row "$title" "$cancel_label" selected_row; then
            [ "$node" = "@main" ] && exit_override="1"
            return
        fi
        target="${browser_targets[$selected_row]}"; kind="${browser_kinds[$selected_row]}"
        case "$kind" in
            directory) browse_menu "$target" "$root" ;;
            script) run_selected_script "$target" ;;
            extension) "${ext_menu_actions[$target]}" ;;
            action)
                case "$target" in
                    @exit) exit_override="1"; return ;;
                    @back) return ;;
                    @about) credits ;;
                    @source) view_script_source "$node" ;;
                esac ;;
        esac
    done
}

