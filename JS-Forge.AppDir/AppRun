# Main Startup Switch
if [ "$1" == "" ]; then

	variables
	bootstrap_runtime_core
	jsf_init_runtime_core
	
	# No zenity installed warning message GUI
	if [ "$gui_flag" = "1" ] && ! command -v zenity >/dev/null 2>&1; then
