#!/bin/bash

# =============================================================================
# System
# =============================================================================

bootstrap_runtime_core() {
    local script_dir source_runtime="" launcher_path
    launcher_path="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null)"
    [ -n "$launcher_path" ] || launcher_path="${BASH_SOURCE[0]}"
    script_dir="$(cd -- "$(dirname -- "$launcher_path")" && pwd -P)" || exit 1
    export JSF_EXEC_DIR="$script_dir"
    app_name="JS-Forge"
    app_data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/$app_name"
    runtime_core_name="runtime-core.lib"
    runtime_core_path="$app_data_dir/$runtime_core_name"
    mkdir -p "$app_data_dir" || exit 1
    if [ -f "$script_dir/$runtime_core_name" ]; then
        source_runtime="$script_dir/$runtime_core_name"
    elif [ -n "$APPDIR" ] && [ -f "$APPDIR/$runtime_core_name" ]; then
        source_runtime="$APPDIR/$runtime_core_name"
    fi
    if [ -z "$source_runtime" ]; then
        echo "Fatal: missing $runtime_core_name beside $launcher_path or in APPDIR." >&2
        exit 1
    fi
    export JSF_BUNDLE_DIR
    JSF_BUNDLE_DIR="$(cd -- "$(dirname -- "$source_runtime")" && pwd -P)" || exit 1
    JSF_LAUNCH_APPDIR="${APPDIR:-}"
    export APPDIR="$JSF_BUNDLE_DIR"
    if [ ! -f "$runtime_core_path" ] || ! cmp -s "$source_runtime" "$runtime_core_path"; then
        cp -- "$source_runtime" "$runtime_core_path" || exit 1
    fi
    source "$runtime_core_path" || {
        echo "Fatal: failed to source $runtime_core_path" >&2
        exit 1
    }
}

variables() {

	# =============================================================================
	# APPLICATION INFORMATION
	# =============================================================================

	app_name="JS-Forge"
	file_name="AppRun"
	command_name="jsforge"
	dev_team="JCore Studios & jcore92"

	app_ver_major="1"
	app_ver_minor="2"
	app_ver_build="1"
	app_ver_stage="beta"
	app_ver_build_date="built on 2026-10-31"
	probe_name="System"

	gitengine_ext_loaded="0" # Only a loaded extension may expose GitEngine.
	allow_user_extensions="0"
	allow_raw_tty="0" # 0 = blocked; 1 = allowed using the headless profile
	exit_override="0"

	# =============================================================================
	# GUI/TUI Picker
	# =============================================================================

	# Sets initial values
	gui_flag="0"
	tui_flag="0"

	# GUI/TUI Switcher
	if [ -t 0 ]; then
		# TERMINAL
		tui_flag="1"

	else
		# GUI
		gui_flag="1"

	fi

	# =============================================================================
	# Generate Extension Menu
	# =============================================================================

	declare -ga ext_menu_order
	declare -gA ext_menu_labels
	declare -gA ext_menu_actions

	# =============================================================================
	# LOCATIONS
	# =============================================================================

	app_temp_loc="/tmp/$app_name"
	#app_install_loc="$HOME/.local/bin"
	app_script_folder_loc="$HOME/.$app_name" # GitEngine scripts only
	bundled_script_root="${JSF_BUNDLE_DIR:-$JSF_EXEC_DIR}/Linux-Control-Panel"
	app_data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/$app_name"
	runtime_core_name="runtime-core.lib"
	runtime_core_path="$app_data_dir/$runtime_core_name"
	eula_acceptance_file="$app_data_dir/.eula_accepted_version"

	# =============================================================================
	# SYSTEM INFORMATION
	# =============================================================================

	current_user="$(whoami)"

	declare -ga xprobe_messages=()

	detect_display_server() {
		if [ -n "$WAYLAND_DISPLAY" ] && [ -n "$DISPLAY" ]; then
			echo "XWayland / Wayland"
		elif [ -n "$WAYLAND_DISPLAY" ] || [ "$XDG_SESSION_TYPE" = "wayland" ]; then
			echo "Wayland"
		elif [ -n "$DISPLAY" ] || [ "$XDG_SESSION_TYPE" = "x11" ]; then
			if command -v Xorg >/dev/null 2>&1; then
				if Xorg -version 2>&1 | grep -iq "XLibre"; then
					echo "XLibre"
					return
				fi
			fi
			echo "X11"
		else
			echo "None"
		fi
	}

	detect_desktop_environment() {
		local current_desktop=""
		local wm_id=""
		local wm_name=""

		current_desktop="$XDG_CURRENT_DESKTOP"

		if [ -z "$current_desktop" ]; then
			[ -n "$XDG_SESSION_DESKTOP" ] && current_desktop="$XDG_SESSION_DESKTOP"
		fi

		if [ -z "$current_desktop" ]; then
			[ -n "$GDMSESSION" ] && current_desktop="$GDMSESSION"
		fi

		if [ -z "$current_desktop" ]; then
			[ -n "$DESKTOP_SESSION" ] && current_desktop="$DESKTOP_SESSION"
		fi

		if [ -z "$current_desktop" ] || [ "$current_desktop" = "default" ]; then
			if pgrep -x "icewm" >/dev/null 2>&1 || pgrep -f "icewm-session" >/dev/null 2>&1; then
				current_desktop="IceWM"
			elif pgrep -x "fluxbox" >/dev/null 2>&1; then
				current_desktop="Fluxbox"
			elif pgrep -x "openbox" >/dev/null 2>&1; then
				current_desktop="Openbox"
			elif pgrep -x "xfwm4" >/dev/null 2>&1 || pgrep -f "xfce4-session" >/dev/null 2>&1; then
				current_desktop="XFCE"
			elif pgrep -x "jwm" >/dev/null 2>&1; then
				current_desktop="JWM"
			fi
		fi

		if [ -z "$current_desktop" ] && [ -n "$DISPLAY" ] && command -v xprop >/dev/null 2>&1; then
			wm_id="$(xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | awk '{print $NF}')"
			if [ -n "$wm_id" ] && [ "$wm_id" != "window" ]; then
				wm_name="$(xprop -id "$wm_id" _NET_WM_NAME 2>/dev/null | cut -d'"' -f2)"
				[ -n "$wm_name" ] && current_desktop="$wm_name"
			fi
		fi

		if [ -z "$current_desktop" ]; then
			if [ -n "$SSH_CONNECTION" ] || [ -n "$SSH_TTY" ]; then
				current_desktop="None (SSH Session)"
			else
				current_desktop="Unknown / Headless"
			fi
		fi

		echo "$current_desktop"
	}

	detect_hostname() {
		if command -v hostname >/dev/null 2>&1; then
			hostname
		else
			cat /proc/sys/kernel/hostname 2>/dev/null
		fi
	}

	detect_lan_ip() {
		local lan_ip

		if command -v hostname >/dev/null 2>&1; then
			lan_ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
		fi

		if [ -z "$lan_ip" ] && command -v ip >/dev/null 2>&1; then
			lan_ip="$(ip route get 1 2>/dev/null | awk '{for (i=1; i<=NF; i++) if ($i=="src") {print $(i+1); exit}}')"
		fi

		[ -n "$lan_ip" ] && echo "$lan_ip" || echo "Unknown"
	}

	detect_init_system() {
		local init_name

		if [ -r /proc/1/comm ]; then
			init_name="$(tr -d '\n' </proc/1/comm)"
		elif command -v ps >/dev/null 2>&1; then
			init_name="$(ps -p 1 -o comm= 2>/dev/null | awk '{print $1}')"
		fi

		case "$init_name" in
		systemd) echo "systemd" ;;
		init) echo "sysVinit" ;;
		runit) echo "runit" ;;
		openrc-init | openrc) echo "OpenRC" ;;
		s6-svscan) echo "s6" ;;
		dinit) echo "dinit" ;;
		busybox) echo "busybox init" ;;
		*) [ -n "$init_name" ] && echo "$init_name" || echo "Unknown" ;;
		esac
	}

	#local detected_display_server
	#local detected_desktop_environment

	jsf_detect_session
	if [ "$desktop_capable" = "1" ]; then
		detected_display_server="$(detect_display_server)"
		detected_desktop_environment="$(detect_desktop_environment)"
	else
		detected_display_server="None (current session)"
		detected_desktop_environment="None ($session_profile)"
	fi
	detected_hostname="$(detect_hostname)"
	detected_lan_ip="$(detect_lan_ip)"
	detected_init_system="$(detect_init_system)"
	DISTRO_FAMILY="$(jsf_detect_distro_family)"

	# =============================================================================
	# EXPORT VARIABLES:
	# =============================================================================

	export DISTRO_FAMILY
	export JSF_APP_NAME="JS-Forge"
	#export JSF_APP_DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/$JSF_APP_NAME"
	#export JSF_RUNTIME_CORE_PATH="$JSF_APP_DATA_DIR/runtime-core.lib"

	# =============================================================================
	# DEFAULT GUI WINDOW SIZES & OVERRIDES BASED ON DE:
	# =============================================================================

	default_eula_gui_dimensions="--width=550 --height=550"
	default_mainmenu_gui_dimensions="--width=450 --height=550"
	default_loading_gui_dimensions="--width=300 --height=200"
	default_messagebox_gui_dimensions="--width=350"

	if [ "$XDG_CURRENT_DESKTOP" == "XFCE" ]; then

		default_eula_gui_dimensions="--width=450 --height=500"
		default_mainmenu_gui_dimensions="--width=400 --height=500"
		default_loading_gui_dimensions="--width=300 --height=200"
		default_messagebox_gui_dimensions="--width=350"

	fi

	if [ "$XDG_CURRENT_DESKTOP" == "COSMIC" ]; then

		default_eula_gui_dimensions="--width=550 --height=600"
		default_mainmenu_gui_dimensions="--width=450 --height=600"
		default_loading_gui_dimensions="--width=300 --height=200"
		default_messagebox_gui_dimensions="--width=350"

	fi

	if [ "$XDG_CURRENT_DESKTOP" == "KDE" ]; then

		default_eula_gui_dimensions="--width=500 --height=500"
		default_mainmenu_gui_dimensions="--width=400 --height=500"
		default_loading_gui_dimensions="--width=300 --height=200"
		default_messagebox_gui_dimensions="--width=350"

	fi

	if [[ "$XDG_CURRENT_DESKTOP" == *GNOME* ]]; then

		default_eula_gui_dimensions="--width=500 --height=500"
		default_mainmenu_gui_dimensions="--width=400 --height=500"
		default_loading_gui_dimensions="--width=300 --height=200"
		default_messagebox_gui_dimensions="--width=350"

	fi

}

