is_runnable_script() {
	local file="$1"

	[[ -f "$file" ]] || return 1

	case "$file" in
	*".$package_manager" | *.sh) return 0 ;;
	*) return 1 ;;
	esac
}

run_selected_script() {
    local full_path="$1"
    local selection
    local no_pause="0"

    selection="$(basename "$full_path")"
    chmod +x "$full_path" >/dev/null 2>&1

    if grep -Eq '^[[:space:]]*jsf_no_pause="1"' "$full_path" 2>/dev/null; then
        no_pause="1"
    fi

    if [ "$gui_flag" = "1" ]; then
        if [ "$no_pause" = "1" ]; then
            jsf_launch_terminal_script_nopause "$full_path"
        else
            jsf_launch_terminal_script "$full_path"
        fi
    else
        sleep .3
        echo ""
        "$full_path"

        if [ "$no_pause" != "1" ]; then
            divider
            entertocontinue | center
        fi
    fi
}

view_script_source() {
	local dir="$1"
	local scripts=()
	local file
	local selection
	local full_path=""

	shopt -s nullglob

	for file in "$dir"/*; do
		if is_runnable_script "$file"; then
			scripts+=("$(basename "$file")")
		fi
	done

	if [ ${#scripts[@]} -eq 0 ]; then
		if [ "$gui_flag" = "1" ]; then
			zenity --error --title="$app_name: Notification" \
				--text="No $app_name compatible files detected in this directory." \
				$default_messagebox_gui_dimensions
		else
			echo "No $app_name compatible files detected in this directory." | center
			entertocontinue
		fi
		return
	fi

	if [ "$gui_flag" = "1" ]; then
		selection=$(zenity --list --column="Scripts" "${scripts[@]}" \
			"<- Back" \
			$default_mainmenu_gui_dimensions \
			--title="$app_name: View Source" \
			--ok-label="Open" \
			--cancel-label="<- Back")
		[ $? -ne 0 ] && return
	else
		cursor_menu " " selection "${scripts[@]}" "<- Back"
	fi

	[ "$selection" = "<- Back" ] && return

	full_path="$dir/$selection"

	if [[ ! -f "$full_path" ]]; then
		if [ "$gui_flag" = "1" ]; then
			zenity --error --text="Error: Could not find the full path for $selection."
		else
			echo "
Error: Could not find the full path for $selection.
" | center
			entertocontinue
		fi
		return
	fi

	nano "$full_path"
}

browse_menu() {
	local dir="$1"
	local root="$2"
	local selection
	local entries=()
	local subdirs=()
	local scripts=()
	local item
	local rel_path

	shopt -s nullglob

	while true; do
		subdirs=()
		scripts=()
		entries=()

		for item in "$dir"/*; do
			[[ -d "$item" ]] && subdirs+=("📁 ${item##*/}")
		done

		for item in "$dir"/*; do
			if is_runnable_script "$item"; then
				scripts+=("📄 $(basename "$item")")
			fi
		done

		entries+=("${subdirs[@]}")
		entries+=("${scripts[@]}")

		if [ "$dir" = "$root" ]; then
			local ext_key

			for ext_key in "${ext_menu_order[@]}"; do
				[ -n "${ext_menu_labels[$ext_key]}" ] || continue
				entries+=("${ext_menu_labels[$ext_key]}")
			done

			entries+=("🪪 About $app_name")
			entries+=("🚪 Exit $app_name")
		else
			if [ "$tui_flag" = "1" ]; then
				entries+=("View Action's Source Code" "<- Back")
			fi
		fi

		if [ ${#subdirs[@]} -eq 0 ] && [ ${#scripts[@]} -eq 0 ] && [ "$dir" != "$root" ]; then
			if [ "$gui_flag" = "1" ]; then
				zenity --error --title="$app_name: Notification" \
					--text="No $app_name compatible files detected in this directory." \
					$default_messagebox_gui_dimensions
			else
				echo "No $app_name compatible files detected in this directory." | center
				entertocontinue
			fi
			return
		fi

		clear && printf '\e[3J'
		jsforge_banner
		echo "$app_name $app_ver_major.$app_ver_minor.$app_ver_build $app_ver_stage" | center

		rel_path="${dir#$root}"
		rel_path="${rel_path#/}"
		local zenity_text

		if [ -z "$rel_path" ]; then
			zenity_text="Main Menu"
		else
			zenity_text="$(printf 'Main Menu\n%s' "${rel_path//\// -> }")"
		fi

		echo "$zenity_text" | center
		divider
		echo "
Select a menu option:" | center

		if [ "$gui_flag" = "1" ]; then
			selection=$(zenity --list \
				--title="$app_name" \
				--text="$zenity_text" \
				--column="Options" "${entries[@]}" \
				$default_mainmenu_gui_dimensions \
				--ok-label="Select" \
				--cancel-label="$([ "$dir" = "$root" ] && echo "Exit" || echo "<- Back")")
			exit_code=$?
			if [ "$exit_code" -ne 0 ]; then
				if [ "$dir" = "$root" ]; then
					exit_override="1"
					return
				else
					return
				fi
			fi
		else
			cursor_menu " " selection "${entries[@]}"
		fi

		local ext_key

		for ext_key in "${ext_menu_order[@]}"; do
			if [ "$selection" = "${ext_menu_labels[$ext_key]}" ]; then
				"${ext_menu_actions[$ext_key]}"
				continue 2
			fi
		done

		case "$selection" in
		"🪪 About $app_name")
			credits
			;;
		"View Action's Source Code")
			view_script_source "$dir"
			;;
		"<- Back")
			return
			;;
		"🚪 Exit $app_name")
			exit_override="1"
			return
			;;
		"📁 "*)
			browse_menu "$dir/${selection#📁 }" "$root"
			;;

		"📄 "*)
			local script_name="${selection#📄 }"
			if [[ -f "$dir/$script_name" ]]; then
				run_selected_script "$dir/$script_name"
			else
				if [ "$gui_flag" = "1" ]; then
					zenity --error --text="Error: Could not find the full path for $script_name."
				else
					echo "
Error: Could not find the full path for $script_name.
" | center
					entertocontinue
				fi
			fi
			;;

		*)
			...
			;;
		esac
	done
}

