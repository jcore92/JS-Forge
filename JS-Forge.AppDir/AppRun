xprobe() {

	#region
	echo "$app_name $app_ver_major.$app_ver_minor.$app_ver_build $app_ver_stage" | center

	echo "$probe_name Report" | center

	divider

	echo ""

	# Initialize array
	xprob_messages=()

	text_delay
	echo "Checking environment..."

	if [ -z "$SSH_CONNECTION" ] && [ -z "$SSH_TTY" ] && [ -t 0 ] && [[ "$(tty 2>/dev/null)" == /dev/tty* ]]; then

		text_delay
		echo " ✕ TTY is not supported. Please use a Desktop Environment to open $app_name." | if [ "$gui_flag" = "1" ]; then
			zenity --text-info $default_mainmenu_gui_dimensions
		else
			cat | print_red
		fi

		if [ "$tui_flag" = "1" ]; then
			divider
			entertocontinue
		fi
		exit
	fi

	if [ -n "$WSL_DISTRO_NAME" ] || [ -n "$IS_WSL" ]; then

		text_delay
		echo " ✕ WSL is not supported." | if [ "$gui_flag" = "1" ]; then
			zenity --text-info $default_mainmenu_gui_dimensions
		else
			cat | print_red
			#entertocontinue
		fi

		if [ "$tui_flag" = "1" ]; then
			divider
			entertocontinue
		fi
		exit
	fi

	#text_delay ; echo "Checking package manager..."

	if [ "$package_manager" != "apt" ] && [ "$package_manager" != "zypper" ] && [ "$package_manager" != "dnf" ] && [ "$package_manager" != "pacman" ] && [ "$package_manager" != "yum" ]; then

		text_delay
		echo " ✕ Unsupported package manager '$package_manager'.

Program cannot continue, exiting." | if [ "$gui_flag" = "1" ]; then
			zenity --text-info $default_mainmenu_gui_dimensions --title="$app_name: $probe_name Report" --cancel-label=""
			#exit
		else
			cat | print_red
		fi

		if [ "$tui_flag" = "1" ]; then
			divider
			entertocontinue
		fi

		exit

	fi

	# Get system's pretty name to display
	prettyname="$(cat /etc/os-release | grep "PRETTY_NAME" | awk -F '"' '{print $2}')"

	# Check the /etc/os-release file for any trace of Ubuntu or Debian: ubuntu debian
	if grep -qi "ubuntu" /etc/os-release; then

		xprob_messages+=("$prettyname")
		xprob_messages+=(" ✓ package manager: $package_manager")
		xprob_messages+=(" ✓ package manager bridge: disabled")
		xprob_messages+=(" ✓ desktop environment: $detected_desktop_environment")

		text_delay
		echo "$prettyname" | if [ "$tui_flag" = "1" ]; then
			cat
		fi

		text_delay
		echo " ✓ package manager: $package_manager" | if [ "$tui_flag" = "1" ]; then
			cat
		fi

		if [ "$tui_flag" = "1" ]; then
			echo " ✓ package manager bridge: disabled"
		#divider
		#entertocontinue
		fi

		text_delay
		echo " ✓ desktop environment: $detected_desktop_environment" | if [ "$tui_flag" = "1" ]; then
			cat
		fi

	elif grep -qi "debian" /etc/os-release; then

		xprob_messages+=("$prettyname")
		xprob_messages+=(" ✓ package manager: $package_manager")
		xprob_messages+=(" ✓ package manager bridge: disabled")
		xprob_messages+=(" ✓ desktop environment: $detected_desktop_environment")

		text_delay
		echo "$prettyname" | if [ "$tui_flag" = "1" ]; then
			cat
		fi

		text_delay
		echo " ✓ package manager: $package_manager" | if [ "$tui_flag" = "1" ]; then
			cat
		fi

		if [ "$tui_flag" = "1" ]; then
			echo " ✓ package manager bridge: disabled"
		#divider
		#entertocontinue
		fi

		text_delay
		echo " ✓ desktop environment: $detected_desktop_environment" | if [ "$tui_flag" = "1" ]; then
			cat
		fi

	else

		if [ "$gui_flag" = "1" ]; then
			echo "# generating results..." >&3
			sleep 1
			echo "# displaying report..." >&3
		fi

		xprob_messages+=("$prettyname")
		xprob_messages+=(" ✓ package manager: $package_manager")
		xprob_messages+=(" ✓ package manager bridge: enabled")
		xprob_messages+=(" ✓ desktop environment: $detected_desktop_environment")

		text_delay
		echo "$prettyname" | if [ "$tui_flag" = "1" ]; then
			cat
		fi

		text_delay
		echo " ✕ apt package manager NOT installed
Enabling the package manager bridge compatibility layer...
(package manager bridge support: zypper, pacman, dnf, yum.)

" | if [ "$gui_flag" = "1" ]; then
			zenity --progress --pulsate --timeout=2 --text="Enabling package manager bridge for non-apt distros..." --title="$app_name: package manager bridge" $default_loading_gui_dimensions --no-cancel &
		else
			cat | print_red
		fi

		text_delay
		echo " ✓ package manager: $package_manager" | if [ "$tui_flag" = "1" ]; then
			cat
		fi

		if [ "$tui_flag" = "1" ]; then
			echo " ✓ package manager bridge: enabled"
		#divider
		#entertocontinue
		fi

		text_delay
		echo " ✓ desktop environment: $detected_desktop_environment" | if [ "$tui_flag" = "1" ]; then
			cat
		fi

		sleep .5
		#exit
	fi

	# Wayland

	xprob_messages+=(" ✓ display server: $detected_display_server")

	text_delay
	echo " ✓ display server: $detected_display_server" | if [ "$tui_flag" = "1" ]; then
		cat
	fi

	# Systemd

	#text_delay ; echo "Checking installed packages..."
	# Optimal for Alpine Linux, but mainstream Linux should already have these installed:

	tool_to_pkg_name() {
		case "$1" in
		"7z") echo "7zip" ;;
		#"7z")  echo "p7zip-full" ;;
		"dig") echo "dnsutils" ;;
		"sha256sum") echo "coreutils" ;;
		"xdg-open") echo "xdg-utils" ;;
		"chsh") echo "shadow" ;;
		"tput") echo "ncurses" ;;
		*) echo "$1" ;;
		esac
	}

	#

	check_programs() {
		declare -g missing=()
		local programs=("flatpak" "zenity" "nano" "git" "jq" "tput" "chsh" "xdg-open") # Add more here

		for prog in "${programs[@]}"; do
			if ! command -v "$prog" &>/dev/null; then

				xprob_messages+=(" ✕ $prog is not installed")

				text_delay
				echo -e " ✕ $prog is not installed" | print_red | if [ "$tui_flag" = "1" ]; then
					cat
				fi

				missing+=("$(tool_to_pkg_name "$prog")")
				#missing+=("$prog")

			else

				xprob_messages+=(" ✓ $prog is installed")

				text_delay
				echo -e " ✓ $prog is installed" | if [ "$tui_flag" = "1" ]; then
					cat
				fi

			fi
		done

		if [ "$gui_flag" = "1" ]; then
			echo "# generating results..." >&3
		fi

		if [ ${#missing[@]} -ne 0 ]; then

			if [ "$gui_flag" = "1" ]; then
				echo "# attempting install..." >&3
			fi

			text_delay
			echo "
Attempting to install package(s):
'${missing[*]}'
" | if [ "$gui_flag" = "1" ]; then
				zenity --text-info --timeout=4 $default_mainmenu_gui_dimensions --title="$app_name: $probe_name Notification" --ok-label="" --cancel-label=""

				if [ "$package_manager" == "apt" ]; then
					x-terminal-emulator -e bash -c "printf ' 🔐 ' ; $pkgmngr_refresh ; $pkgmngr_install ${missing[*]}; echo \"\"; read -p \"Press enter to continue\";"
				else
					# List of terminal emulators with their -e syntax
					terminals=(
						"xfce4-terminal -x"   # XFCE
						"konsole --execute"   # KDE
						"mate-terminal -x"    # MATE
						"kitty --execute"     # Kitty
						"gnome-terminal --"   # GNOME
						"lxterminal -e"       # LXDE
						"tilix -e"            # Tilix (VTE-based)
						"alacritty --command" # Alacritty
						"urxvt -e"            # RXVT
						"terminator -e"       # Terminator
						"deepin-terminal -e"  # Deepin
						"wezterm start --"    # WezTerm
						"xterm -e"            # XTerm
					)

					terminal_launched=false

					for term in "${terminals[@]}"; do
						cmd=($term) # Split into command and args
						if command -v "${cmd[0]}" &>/dev/null; then
							"${cmd[@]}" bash -c "printf ' 🔐 ' ; $pkgmngr_refresh ; $pkgmngr_install ${missing[*]}; echo \"\"; read -p \"Press enter to continue\";"
							terminal_launched=true
							break # Exit the loop after the first successful command
						fi
					done

					# Only show error if *no* terminal could be launched
					if [[ "$terminal_launched" == false ]]; then
						echo "No terminal emulator found. Please install xfce4-terminal, kitty, konsole, gnome-terminal, xterm, or another commonly installed terminal emulator or use this program in TUI mode." |
							zenity --info --title="$app_name: Notification" --text="$(cat)" $default_messagebox_gui_dimensions
					fi
				fi

				# exec bash
				endprog
			else
				cat
				printf " 🔐 "
				$pkgmngr_refresh
				$pkgmngr_install ${missing[*]}
				endprog
			fi

			return 1
		fi
	}

	# Check Programs Loop
	if check_programs; then
		#check_appimagelauncher

		if [ "$gui_flag" = "1" ]; then
			echo "# displaying report..." >&3
		fi

		sleep .3
	else

		if [ "$gui_flag" = "1" ]; then
			echo "# displaying report..." >&3
		fi

		text_delay
		echo "
Please install missing packages using this $probe_name tool or by using the command below (in a terminal), then restart $app_name:

$pkgmngr_install ${missing[*]}" | if [ "$gui_flag" = "1" ]; then
			zenity --text-info $default_mainmenu_gui_dimensions --title="$app_name: $probe_name Report" --cancel-label=""
			endprog
		else
			cat | print_red
		fi

		if [ "$tui_flag" = "1" ]; then
			divider
			entertocontinue
		fi

		endprog
	fi
	#endregion
}

load_extensions() {
	echo "$app_name $app_ver_major.$app_ver_minor.$app_ver_build $app_ver_stage" | center
	echo "Extensions" | center
	divider
	echo ""
	echo "Loading extensions...
"

	xprob_messages+=("")
	xprob_messages+=("Extensions")

	resolve_extension_dirs
	shopt -s nullglob

	local found_any="0"
	local ext_files=()
	local ext_dir
	local file
	local extension_filename

	for ext_dir in "${extension_dirs[@]}"; do
		ext_files=("$ext_dir"/*.ext)

		for file in "${ext_files[@]}"; do
			[ -f "$file" ] || continue
			source "$file"
			extension_filename="$(basename "$file")"
			xprob_messages+=(" ✓ $extension_filename loaded")
			found_any="1"
		done
	done

	if [ "$found_any" = "0" ]; then
		xprob_messages+=(" ✕ no extensions found.")
		echo "No .ext files found"
		sleep 2
	fi
}

# =============================================================================
# Menus
# =============================================================================

is_runnable_script() {
	local file="$1"

	[[ -f "$file" ]] || return 1

	case "$file" in
	*".$package_manager" | *.sh) return 0 ;;
	*) return 1 ;;
	esac
}

run_selected_script() {
	local full_path="$1"
	local selection
	selection="$(basename "$full_path")"

	chmod +x "$full_path" >/dev/null 2>&1

	if [ "$gui_flag" = "1" ]; then
		exec 3> >(zenity --progress --pulsate --auto-close \
			--text="Running $selection..." \
			--title="$app_name: Action" \
			$default_loading_gui_dimensions)
		echo "# Running $selection..." >&3
		sleep 1.2
		echo "100" >&3
		exec 3>&-
	else
		echo "
Running $selection...

$full_path" | center
		divider
		echo ""
	fi

	if [ "$gui_flag" = "1" ]; then
		if [ "$package_manager" = "apt" ]; then
			x-terminal-emulator -e bash -c "\"$full_path\"; echo; read -p 'Press enter to continue'"
		else
			terminals=(
				"xfce4-terminal -x"
				"konsole --execute"
				"mate-terminal -x"
				"kitty --execute"
				"gnome-terminal --"
				"lxterminal -e"
				"tilix -e"
				"alacritty --command"
				"urxvt -e"
				"terminator -e"
				"deepin-terminal -e"
				"wezterm start --"
				"xterm -e"
			)

			terminal_launched=false

			for term in "${terminals[@]}"; do
				cmd=($term)
				if command -v "${cmd[0]}" &>/dev/null; then
					"${cmd[@]}" bash -c "\"$full_path\"; echo; read -p 'Press enter to continue'"
					terminal_launched=true
					break
				fi
			done

			if [[ "$terminal_launched" == false ]]; then
				echo "No terminal emulator found. Please install xfce4-terminal, kitty, konsole, gnome-terminal, xterm, or another common terminal emulator, or use this program in TUI mode." |
					zenity --info --title="$app_name: Notification" --text="$(cat)" $default_messagebox_gui_dimensions
			fi
		fi
	else
		sleep .3
		"$full_path"
		divider
		entertocontinue | center
	fi
}

view_script_source() {
	local dir="$1"
	local scripts=()
	local file
	local selection
	local full_path=""

	shopt -s nullglob

	for file in "$dir"/*; do
		if is_runnable_script "$file"; then
			scripts+=("$(basename "$file")")
		fi
	done

	if [ ${#scripts[@]} -eq 0 ]; then
		if [ "$gui_flag" = "1" ]; then
			zenity --error --title="$app_name: Notification" \
				--text="No $app_name compatible files detected in this directory." \
				$default_messagebox_gui_dimensions
		else
			echo "No $app_name compatible files detected in this directory." | center
			entertocontinue
		fi
		return
	fi

	if [ "$gui_flag" = "1" ]; then
		selection=$(zenity --list --column="Scripts" "${scripts[@]}" \
			"<- Back" \
			$default_mainmenu_gui_dimensions \
			--title="$app_name: View Source" \
			--ok-label="Open" \
			--cancel-label="<- Back")
		[ $? -ne 0 ] && return
	else
		cursor_menu " " selection "${scripts[@]}" "<- Back"
	fi

	[ "$selection" = "<- Back" ] && return

	full_path="$dir/$selection"

	if [[ ! -f "$full_path" ]]; then
		if [ "$gui_flag" = "1" ]; then
			zenity --error --text="Error: Could not find the full path for $selection."
		else
			echo "
Error: Could not find the full path for $selection.
" | center
			entertocontinue
		fi
		return
	fi

	nano "$full_path"
}

browse_menu() {
	local dir="$1"
	local root="$2"
	local selection
	local entries=()
	local subdirs=()
	local scripts=()
	local item
	local rel_path

	shopt -s nullglob

	while true; do
		subdirs=()
		scripts=()
		entries=()

		for item in "$dir"/*; do
			[[ -d "$item" ]] && subdirs+=("📁 ${item##*/}")
		done

		for item in "$dir"/*; do
			if is_runnable_script "$item"; then
				scripts+=("📄 $(basename "$item")")
			fi
		done

		entries+=("${subdirs[@]}")
		entries+=("${scripts[@]}")

		if [ "$dir" = "$root" ]; then
			local ext_key

			for ext_key in "${ext_menu_order[@]}"; do
				[ -n "${ext_menu_labels[$ext_key]}" ] || continue
				entries+=("${ext_menu_labels[$ext_key]}")
			done

			entries+=("📋 View $probe_name Report" "🪪 About $app_name")
			entries+=("🚪 Exit $app_name")
		else
			if [ "$tui_flag" = "1" ]; then
				entries+=("View Action's Source Code" "<- Back")
			fi
		fi

		if [ ${#subdirs[@]} -eq 0 ] && [ ${#scripts[@]} -eq 0 ] && [ "$dir" != "$root" ]; then
			if [ "$gui_flag" = "1" ]; then
				zenity --error --title="$app_name: Notification" \
					--text="No $app_name compatible files detected in this directory." \
					$default_messagebox_gui_dimensions
			else
				echo "No $app_name compatible files detected in this directory." | center
				entertocontinue
			fi
			return
		fi

		clear && printf '\e[3J'
		jsforge_banner
		echo "$app_name $app_ver_major.$app_ver_minor.$app_ver_build $app_ver_stage" | center

		rel_path="${dir#$root}"
		rel_path="${rel_path#/}"
		local zenity_text

		if [ -z "$rel_path" ]; then
			zenity_text="Main Menu"
		else
			zenity_text="$(printf 'Main Menu\n%s' "${rel_path//\// -> }")"
		fi

		echo "$zenity_text" | center
		divider
		echo "
Select a menu option:" | center

		if [ "$gui_flag" = "1" ]; then
			selection=$(zenity --list \
				--title="$app_name" \
				--text="$zenity_text" \
				--column="Options" "${entries[@]}" \
				$default_mainmenu_gui_dimensions \
				--ok-label="Select" \
				--cancel-label="$([ "$dir" = "$root" ] && echo "Exit" || echo "<- Back")")
			exit_code=$?
			if [ "$exit_code" -ne 0 ]; then
				if [ "$dir" = "$root" ]; then
					exit_override="1"
					return
				else
					return
				fi
			fi
		else
			cursor_menu " " selection "${entries[@]}"
		fi

		local ext_key

		for ext_key in "${ext_menu_order[@]}"; do
			if [ "$selection" = "${ext_menu_labels[$ext_key]}" ]; then
				"${ext_menu_actions[$ext_key]}"
				continue 2
			fi
		done

		case "$selection" in
		"📋 View $probe_name Report")
			if [ "$gui_flag" = "1" ]; then
				printf '%s\n' "${xprob_messages[@]}" | zenity --text-info \
					--title="$app_name: $probe_name Report" \
					$default_mainmenu_gui_dimensions
			else
				divider
				echo ""
				printf '%s\n' "${xprob_messages[@]}"
				divider
				entertocontinue
			fi
			;;
		"🪪 About $app_name")
			credits
			;;
		"View Action's Source Code")
			view_script_source "$dir"
			;;
		"<- Back")
			return
			;;
		"🚪 Exit $app_name")
			exit_override="1"
			return
			;;
		"📁 "*)
			browse_menu "$dir/${selection#📁 }" "$root"
			;;

		"📄 "*)
			local script_name="${selection#📄 }"
			if [[ -f "$dir/$script_name" ]]; then
				run_selected_script "$dir/$script_name"
			else
				if [ "$gui_flag" = "1" ]; then
					zenity --error --text="Error: Could not find the full path for $script_name."
				else
					echo "
Error: Could not find the full path for $script_name.
" | center
					entertocontinue
				fi
			fi
			;;

		*)
			...
			;;
		esac
	done
}

# =============================================================================
# Runtime
# =============================================================================

# -s/script Variable Loading Switch
if [ "$1" == -s ]; then

	clear
	variables
	jsforge_banner
	echo "$app_name $app_ver_major.$app_ver_minor.$app_ver_build $app_ver_stage" | center
	echo "Script Runtime Environment" | center
	divider
	#echo ""
	#echo " ✓ variables loaded."
	sleep .5

	if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
		# Executed directly
		clear
	else
		# Sourced
		#divider
		echo ""
	fi

fi

# Main Startup Switch
if [ "$1" == "" ]; then

	variables

	eula_prompt

	if [ "$gui_flag" = "1" ]; then
		# Send progress updates to Zenity on a separate file descriptor
		exec 3> >(zenity --progress --pulsate --auto-close --text="Running $probe_name..." --title="$app_name: $probe_name Analysis" $default_loading_gui_dimensions --no-cancel)
		echo "# scanning system..." >&3
		xprobe
		load_extensions
		echo "100" >&3
		exec 3>&-                                                                                                                                      # Close fd
		printf '%s\n' "${xprob_messages[@]}" | zenity --text-info --title="$app_name: $probe_name Report" --timeout=3 $default_mainmenu_gui_dimensions #--ok-label="" --cancel-label=""
		#exit
	else
		clear
		jsforge_banner
		xprobe
		sleep 1
		clear
		jsforge_banner
		load_extensions
	fi

	if [ "$tui_flag" = "1" ]; then

		sleep 1

	fi

	browse_menu "$app_script_folder_loc" "$app_script_folder_loc"

	exit_override="1"

	credits

	clear

	endprog

fi

# -t/testing Startup Switch
if [ "$1" == "-t" ]; then

	clear

	variables

	SCRIPT_PATH="$(readlink -f "$0")"
	SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"

	if [ "$SCRIPT_DIR" != "$app_install_loc" ]; then
		# Not in install directory, running installer
		jsforge_banner
		echo "$app_name $app_ver_major.$app_ver_minor.$app_ver_build $app_ver_stage" | center
		echo "Installation Runtime" | center
		divider
		echo ""
		echo " ✕ $app_name is not in installation directory, skipping to installer.
"
		echo "not ready... exiting..."
		sleep 5
		clear
		endprog
	fi

fi
