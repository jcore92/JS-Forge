		#exit
	else
		clear
		jsforge_banner
		load_extensions
	fi

	if [ "$tui_flag" = "1" ]; then

		sleep 1

	fi

	browse_menu "$app_script_folder_loc" "$app_script_folder_loc"

	exit_override="1"

	credits

	clear

	endprog

fi

