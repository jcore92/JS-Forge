load_extensions() {
    echo "$app_name $app_ver_major.$app_ver_minor.$app_ver_build $app_ver_stage" | center
    echo "Extensions" | center
    divider
    echo ""
    echo "Loading extensions..."
    echo ""

    local ext_dir
    local file
    local extension_filename
    local found_any="0"
    local ext_report_lines=()

    declare -A loaded_extension_names

    # Use the extension_dirs prepared by runtime core
    # If somehow empty, fall back to exec dir and/or app_script_folder_loc
    if [ "${#extension_dirs[@]}" -eq 0 ]; then
        extension_dirs=()

        if [ -n "$APPDIR" ] && [ -d "$APPDIR" ]; then
            extension_dirs+=( "$APPDIR" )
        fi

        if [ -n "$JSF_EXEC_DIR" ] && [ -d "$JSF_EXEC_DIR" ]; then
            extension_dirs+=( "$JSF_EXEC_DIR" )
        fi

        if [ "$allow_user_extensions" = "1" ]; then
            extension_dirs+=( "$app_script_folder_loc" )
        fi
    fi

    for ext_dir in "${extension_dirs[@]}"; do
        [ -d "$ext_dir" ] || continue

        shopt -s nullglob
        for file in "$ext_dir"/*.ext; do
            [ -f "$file" ] || continue

            extension_filename="$(basename "$file")"

            if [ -n "${loaded_extension_names[$extension_filename]}" ]; then
                continue
            fi

            echo "Loading $extension_filename extension."
            echo ""

            # shellcheck disable=SC1090
            source "$file"
            loaded_extension_names["$extension_filename"]="1"
            ext_report_lines+=( " ✓ $extension_filename loaded" )
            found_any="1"
        done
        shopt -u nullglob
    done

    xprobe_messages+=( "" )
    xprobe_messages+=( "Extensions" )

    if [ "$found_any" = "0" ]; then
        xprobe_messages+=( " ✕ no extensions found." )
        echo "No .ext files found"
        sleep 2
    else
        xprobe_messages+=( "${ext_report_lines[@]}" )
    fi
}

