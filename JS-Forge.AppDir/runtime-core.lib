#!/bin/bash

# =============================================================================
# Terminal Interface
# =============================================================================

center() {
	local width
	width="${COLUMNS:-$(tput cols)}"
	while IFS= read -r line; do
		# Strip color codes to get the actual text length
		local stripped_line=$(echo "$line" | sed 's/\x1b\[[0-9;]*m//g')
		local actual_length=${#stripped_line}

		if ((actual_length == width)); then
			printf '%s\n' "$line"
			continue
		fi

		if ((actual_length > width)); then
			while read -r subline; do
				local stripped_subline=$(echo "$subline" | sed 's/\x1b\[[0-9;]*m//g')
				local subline_length=${#stripped_subline}

				if ((subline_length == width)); then
					printf '%s\n' "$subline"
					continue
				fi
				printf '%*s\n' $(((subline_length + width) / 2)) "$subline"
			done < <(fold -w "$width" <<<"$line")
			continue
		fi

		printf '%*s\n' $(((actual_length + width) / 2)) "$line"
	done <"${1:-/dev/stdin}"
}

print_red() {
	while IFS= read -r line; do
		# Calculate the length of the original line
		local original_length=${#line}
		# Print the line in red, ensuring the length is preserved
		printf "\033[31m%s\033[0m\n" "$line"
	done
}

divider() {
	echo ""
	printf -- ".%.0s" $(seq $(tput cols))
	echo ""
}

cursor_menu() {
	local prompt="$1" outvar="$2" options=("${@:3}")
	local cur=0 count=${#options[@]}
	local esc=$(echo -en "\e")

	printf "$prompt\n"
	while true; do
		local index=0
		for o in "${options[@]}"; do
			if [ $index -eq $cur ]; then
				echo -e " >\e[7m$o\e[0m"
			else
				echo "  $o"
			fi
			((index++))
		done

		read -s -n3 key
		case "$key" in
		"$esc[A")
			((cur--))
			((cur < 0)) && cur=0
			;;
		"$esc[B")
			((cur++))
			((cur >= count)) && cur=$((count - 1))
			;;
		"") break ;;
		esac
		echo -en "\e[${count}A"
	done

	printf -v "$outvar" "${options[$cur]}"
}

text_delay() {

	sleep .1

}

entertocontinue() {

	entertocontinue=(
		""
		"Press enter to continue"
	)

	# Get the terminal width
	term_width=$(tput cols)

	# Function to center a line
	center_line() {
		local line="$1"
		local line_length=${#line}
		local padding=$(((term_width - line_length) / 2))
		printf "%${padding}s%s%${padding}s\n" "" "$line" ""
	}

	# Center each line of the image
	for line in "${entertocontinue[@]}"; do
		center_line "$line"
	done

	read -p ""

}

endprog() {

	exit

}

# =============================================================================
# Runtime Logic
# =============================================================================

jsf_runtime_core_loaded="1"

jsf_init_runtime_core() {
	#PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
	#export PATH
	app_data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/$app_name"
	runtime_core_name="runtime-core.lib"
	runtime_core_path="$app_data_dir/$runtime_core_name"
	app_temp_loc="/tmp/$app_name"

	mkdir -p "$app_data_dir"
	mkdir -p "$app_temp_loc"

	resolve_extension_dirs
	jsf_detect_privilege
	jsf_detect_package_manager
}

resolve_extension_dirs() {
	local exec_dir
	local user_ext_dir
	declare -A seen_dirs=()

	exec_dir="${JSF_EXEC_DIR:-$(cd -- "$(dirname -- "${BASH_SOURCE[1]}")" && pwd -P)}"
	user_ext_dir="${XDG_DATA_HOME:-$HOME/.local/share}/$app_name"

	extension_dirs=()

	if [ -n "$APPDIR" ] && [ -d "$APPDIR" ]; then
		local real_appdir
		real_appdir="$(cd -- "$APPDIR" && pwd -P)"
		if [ -z "${seen_dirs[$real_appdir]}" ]; then
			extension_dirs+=("$real_appdir")
			seen_dirs["$real_appdir"]="1"
		fi
	elif [ -d "$exec_dir" ]; then
		local real_exec_dir
		real_exec_dir="$(cd -- "$exec_dir" && pwd -P)"
		if [ -z "${seen_dirs[$real_exec_dir]}" ]; then
			extension_dirs+=("$real_exec_dir")
			seen_dirs["$real_exec_dir"]="1"
		fi
	fi

	if [ "$allow_user_extensions" = "1" ]; then
		mkdir -p "$user_ext_dir"
		local real_user_dir
		real_user_dir="$(cd -- "$user_ext_dir" && pwd -P)"
		if [ -z "${seen_dirs[$real_user_dir]}" ]; then
			extension_dirs+=("$real_user_dir")
			seen_dirs["$real_user_dir"]="1"
		fi
	fi
}

jsf_detect_privilege() {
	current_user="$(whoami)"

	if ((EUID == 0)); then
		sudocmd=""
	elif command -v sudo >/dev/null 2>&1; then
		sudocmd="sudo "
	else
		sudocmd=""
	fi
}

jsf_detect_package_manager() {
	package_manager="$(
		for cmd in apt dnf yum pacman zypper; do
			command -v "$cmd" >/dev/null 2>&1 && echo "$cmd" && break
		done
	)"

	pkgmngr_install=""
	pkgmngr_refresh=""

	if [ "$package_manager" = "apt" ]; then
		pkgmngr_install="$sudocmd$package_manager install -y"
		pkgmngr_refresh="$sudocmd$package_manager update"
	fi

	if [ "$package_manager" = "dnf" ]; then
		pkgmngr_install="$sudocmd$package_manager install -y"
		pkgmngr_refresh="$sudocmd$package_manager makecache"
	fi

	if [ "$package_manager" = "yum" ]; then
		pkgmngr_install="$sudocmd$package_manager install -y"
		pkgmngr_refresh="$sudocmd$package_manager check-update"
	fi

	if [ "$package_manager" = "pacman" ]; then
		pkgmngr_install="$sudocmd$package_manager -Syu --noconfirm"
		pkgmngr_refresh="sleep .1"
	fi

	if [ "$package_manager" = "zypper" ]; then
		pkgmngr_install="$sudocmd$package_manager install -y"
		pkgmngr_refresh="$sudocmd$package_manager refresh"
	fi
}

jsf_launch_terminal_command() {
	local command_string="$1"

	if [ "$gui_flag" != "1" ]; then
		bash -c "$command_string"
		return $?
	fi

	if [ "$package_manager" = "apt" ] && command -v x-terminal-emulator >/dev/null 2>&1; then
		x-terminal-emulator -e bash -c "$command_string"
		return $?
	fi

	local terminals=(
		"xfce4-terminal -x"
		"konsole --execute"
		"mate-terminal -x"
		"kitty --execute"
		"gnome-terminal --"
		"lxterminal -e"
		"tilix -e"
		"alacritty --command"
		"urxvt -e"
		"terminator -e"
		"deepin-terminal -e"
		"wezterm start --"
		"xterm -e"
	)

	local term
	local cmd

	for term in "${terminals[@]}"; do
		cmd=($term)
		if command -v "${cmd[0]}" >/dev/null 2>&1; then
			"${cmd[@]}" bash -c "$command_string"
			return $?
		fi
	done

	if command -v zenity >/dev/null 2>&1; then
		echo "No terminal emulator found. Please install xfce4-terminal, kitty, konsole, gnome-terminal, xterm, or use this program in TUI mode." |
			zenity --info --title="$app_name: Notification" --text="$(cat)" $default_messagebox_gui_dimensions
	else
		echo "No terminal emulator found. Please use this program in TUI mode." >&2
	fi

	return 1
}

jsf_launch_terminal_script() {
	local full_path="$1"
	jsf_launch_terminal_command "\"$full_path\"; echo; read -p 'Press enter to continue'"
}

jsf_launch_terminal_script_nopause() {
	local full_path="$1"
	local launch_delay="${JSF_LAUNCH_DELAY:-0.2}"
	jsf_launch_terminal_command "\"$full_path\"; sleep $launch_delay"
}

# =============================================================================
# Dependency helpers
# Native packages + Flatpaks
# =============================================================================

jsf_detect_distro_family() {
	local distro_id=""
	local distro_like=""

	if [ -r /etc/os-release ]; then
		distro_id="$(awk -F= '/^ID=/{gsub(/"/, "", $2); print tolower($2)}' /etc/os-release)"
		distro_like="$(awk -F= '/^ID_LIKE=/{gsub(/"/, "", $2); print tolower($2)}' /etc/os-release)"
	fi

	case "$distro_id" in
	debian | ubuntu | devuan)
		echo "debian"
		;;
	arch | artix)
		echo "arch"
		;;
	fedora | rhel | centos | rocky | almalinux)
		echo "rhel"
		;;
	suse | opensuse* | sles)
		echo "suse"
		;;
	mandriva | openmandriva | pclinuxos)
		echo "mandriva"
		;;
	*)
		case "$distro_like" in
		*debian*) echo "debian" ;;
		*arch*) echo "arch" ;;
		*rhel* | *fedora*) echo "rhel" ;;
		*suse* | *opensuse*) echo "suse" ;;
		*mandriva* | *openmandriva*) echo "mandriva" ;;
		*) echo "generic" ;;
		esac
		;;
	esac
}

jsf_tool_to_pkg_name() {
	local family="${DISTRO_FAMILY:-$(jsf_detect_distro_family)}"

	case "$family" in
	debian)
		case "$1" in
		"7z") echo "7zip" ;;
		"dig") echo "dnsutils" ;;
		"sha256sum") echo "coreutils" ;;
		"xdg-open") echo "xdg-utils" ;;
		"chsh") echo "shadow" ;;
		"tput") echo "ncurses-bin" ;;
		"whiptail") echo "whiptail" ;;
		"clamscan") echo "clamav" ;;
		"freshclam") echo "clamav-freshclam" ;;
		"clamdscan") echo "clamdscan" ;;
		"clamd") echo "clamav-daemon" ;;
		"ufw") echo "ufw" ;;
		"crontab") echo "cronie" ;;
		"libreoffice") echo "libreoffice" ;;
		"vivaldi-stable") echo "vivaldi-browser" ;;
		"brave-browser-stable") echo "brave-browser-stable" ;;
		"rustdesk") echo "rustdesk" ;;
		*) echo "$1" ;;
		esac
		;;
	arch)
		case "$1" in
		"7z") echo "7zip" ;;
		"dig") echo "bind" ;;
		"sha256sum") echo "coreutils" ;;
		"xdg-open") echo "xdg-utils" ;;
		"chsh") echo "util-linux" ;;
		"tput") echo "ncurses" ;;
		"whiptail") echo "libnewt" ;;
		"clamscan" | "freshclam" | "clamdscan" | "clamd") echo "clamav" ;;
		"ufw") echo "ufw" ;;
		"crontab") echo "cronie" ;;
		"libreoffice") echo "libreoffice" ;;
		"vivaldi-stable") echo "vivaldi-browser" ;;
		"brave-browser-stable") echo "brave-browser-stable" ;;
		"rustdesk") echo "rustdesk" ;;
		*) echo "$1" ;;
		esac
		;;
	rhel)
		case "$1" in
		"7z") echo "7zip" ;;
		"dig") echo "bind-utils" ;;
		"sha256sum") echo "coreutils" ;;
		"xdg-open") echo "xdg-utils" ;;
		"chsh") echo "util-linux-user" ;;
		"tput") echo "ncurses" ;;
		"whiptail") echo "newt" ;;
		"clamscan") echo "clamav" ;;
		"freshclam") echo "clamav-update" ;;
		"clamdscan" | "clamd") echo "clamd" ;;
		"ufw") echo "ufw" ;;
		"crontab") echo "cronie" ;;
		"libreoffice") echo "libreoffice" ;;
		"vivaldi-stable") echo "vivaldi-browser" ;;
		"brave-browser-stable") echo "brave-browser-stable" ;;
		"rustdesk") echo "rustdesk" ;;
		*) echo "$1" ;;
		esac
		;;
	mandriva)
		libreoffice_pkg="$(dnf search libreoffice 2>/dev/null | awk '$1 ~ /^libreoffice[0-9][0-9.]*\.(x86_64|aarch64|i[3-6]86)$/ {sub(/\.[^.]+$/, "", $1); print $1; exit}')"
		case "$1" in
		"7z") echo "7zip" ;;
		"dig") echo "bind-utils" ;;
		"sha256sum") echo "coreutils" ;;
		"xdg-open") echo "xdg-utils" ;;
		"chsh") echo "util-linux-user" ;;
		"tput") echo "ncurses" ;;
		"whiptail") echo "newt" ;;
		"clamscan") echo "clamav" ;;
		"freshclam") echo "clamav-db" ;;
		"clamdscan" | "clamd") echo "clamd" ;;
		"ufw") echo "ufw" ;;
		"crontab") echo "cronie" ;;
		"libreoffice") echo "${libreoffice_pkg:-libreoffice}" ;;
		"vivaldi-stable") echo "vivaldi-browser" ;;
		"brave-browser-stable") echo "brave-browser-stable" ;;
		"rustdesk") echo "rustdesk" ;;
		*) echo "$1" ;;
		esac
		;;
	suse)
		case "$1" in
		"7z") echo "7zip" ;;
		"dig") echo "bind-utils" ;;
		"sha256sum") echo "coreutils" ;;
		"xdg-open") echo "xdg-utils" ;;
		"chsh") echo "shadow" ;;
		"tput") echo "ncurses" ;;
		"whiptail") echo "newt" ;;
		"clamscan" | "freshclam" | "clamdscan" | "clamd") echo "clamav" ;;
		"ufw") echo "ufw" ;;
		"crontab") echo "cronie" ;;
		"libreoffice") echo "libreoffice" ;;
		"vivaldi-stable") echo "vivaldi-browser" ;;
		"brave-browser-stable") echo "brave-browser-stable" ;;
		"rustdesk") echo "rustdesk-server" ;;
		*) echo "$1" ;;
		esac
		;;
	*)
		case "$1" in
		"7z") echo "7zip" ;;
		"dig") echo "dnsutils" ;;
		"sha256sum") echo "coreutils" ;;
		"xdg-open") echo "xdg-utils" ;;
		"chsh") echo "shadow" ;;
		"tput") echo "ncurses" ;;
		"whiptail") echo "whiptail" ;;
		"ufw") echo "ufw" ;;
		"crontab") echo "cronie" ;;
		"libreoffice") echo "libreoffice" ;;
		"vivaldi-stable") echo "vivaldi-browser" ;;
		"brave-browser-stable") echo "brave-browser-stable" ;;
		"rustdesk") echo "rustdesk" ;;
		*) echo "$1" ;;
		esac
		;;
	esac
}

jsf_is_native_installed() {
	command -v "$1" >/dev/null 2>&1
}

jsf_is_flatpak_installed() {
	local app_id="$1"
	flatpak list --user --app --columns=application 2>/dev/null | grep -Fxq "$app_id"
}

jsf_ensure_flathub() {
	if ! flatpak remotes --user --columns=name 2>/dev/null | grep -Fxq "flathub"; then
		flatpak --user remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
	fi
}

jsf_install_native_packages() {
	local missing=()
	local dep

	for dep in "$@"; do
		if ! jsf_is_native_installed "$dep"; then
			missing+=("$(jsf_tool_to_pkg_name "$dep")")
		fi
	done

	if [ ${#missing[@]} -eq 0 ]; then
		return 0
	fi

	text_delay
	echo "
Attempting to install package(s):
'${missing[*]}'
" | if [ "$gui_flag" = "1" ]; then
		zenity --text-info --timeout=4 $default_mainmenu_gui_dimensions --title="$app_name: Dependency Installer" --ok-label="" --cancel-label=""
	else
		cat
	fi

	if [ "$gui_flag" = "1" ]; then
		jsf_launch_terminal_command "printf ' 🔐 ' ; $pkgmngr_refresh ; $pkgmngr_install ${missing[*]}; echo \"\"; read -p \"Press enter to continue\";"
		endprog
	else
		printf " 🔐 "
		$pkgmngr_refresh
		$pkgmngr_install ${missing[*]}
	fi

	return 0
}

jsf_install_flatpaks() {
	local missing=()
	local app_id

	for app_id in "$@"; do
		if ! jsf_is_flatpak_installed "$app_id"; then
			missing+=("$app_id")
		fi
	done

	if [ ${#missing[@]} -eq 0 ]; then
		return 0
	fi

	jsf_ensure_flathub

	if [ "$gui_flag" = "1" ]; then
		jsf_launch_terminal_command "flatpak --user install -y flathub ${missing[*]}; echo \"\"; read -p \"Press enter to continue\";"
		endprog
	else
		flatpak --user install -y flathub ${missing[*]}
	fi

	return 0
}

jsf_require_all() {
	local native_deps=()
	local flatpak_deps=()
	local mode=""
	local arg

	for arg in "$@"; do
		case "$arg" in
		--native | --flatpak)
			mode="$arg"
			;;
		*)
			case "$mode" in
			--native) native_deps+=("$arg") ;;
			--flatpak) flatpak_deps+=("$arg") ;;
			esac
			;;
		esac
	done

	if [ ${#native_deps[@]} -ne 0 ]; then
		jsf_install_native_packages "${native_deps[@]}" || return 1
	fi

	if [ ${#flatpak_deps[@]} -ne 0 ]; then
		jsf_install_flatpaks "${flatpak_deps[@]}" || return 1
	fi

	return 0
}

jsf_github_latest_asset_url() {
	local repository="$1"
	local asset_pattern="$2"

	curl --silent --show-error --fail \
		--connect-timeout 15 \
		--max-time 45 \
		-H "Accept: application/vnd.github+json" \
		"https://api.github.com/repos/$repository/releases/latest" |
		jq -r --arg pattern "$asset_pattern" '
            .assets[]?
            | select(.browser_download_url | test($pattern; "i"))
            | .browser_download_url
        ' |
		head -n 1
}

jsf_install_github_appimage() {
    local app_id="$1"
    local github_repository="$2"
    local asset_pattern="$3"
    local launch="0"
    local appimage_dir="$HOME/AppImages"
    local download_dir="$HOME/Downloads"
    local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/JS-Forge/appimages"
    local state_file
    local app_file_key
    local appimage_path=""
    local appimage_url
    local asset_name
    local download_path
    local partial_path
    local option

    shift 3

    while [ "$#" -gt 0 ]; do
        option="$1"

        case "$option" in
            --launch)
                launch="1"
                shift
                ;;
            *)
                echo "Unknown AppImage option: $option" >&2
                return 1
                ;;
        esac
    done

    [ -n "$app_id" ] &&
        [ -n "$github_repository" ] &&
        [ -n "$asset_pattern" ] || {
        echo "AppImage install details are incomplete." >&2
        return 1
    }

    mkdir -p "$appimage_dir" "$download_dir" "$state_dir" || {
        echo "Could not create an AppImage storage directory." >&2
        return 1
    }

    state_file="$state_dir/$app_id.path"
    app_file_key="$(printf '%s' "$app_id" | tr '[:upper:]' '[:lower:]' | tr -cd '[:alnum:]')"

    [ -n "$app_file_key" ] || {
        echo "AppImage ID must contain at least one letter or number." >&2
        return 1
    }

    if [ -r "$state_file" ]; then
        appimage_path="$(cat "$state_file" 2>/dev/null)"

        if [ -f "$appimage_path" ]; then
            echo "$app_id is already installed: $appimage_path"

            if [ "$launch" = "1" ]; then
                echo "Launching $app_id..."
                setsid "$appimage_path" >/dev/null 2>&1 < /dev/null &
            fi

            return 0
        fi
    fi

    appimage_path="$(
        find "$appimage_dir" \
            -maxdepth 1 \
            -type f \
            -iname "${app_file_key}*appimage" \
            -print -quit
    )"

    if [ -n "$appimage_path" ] && [ -f "$appimage_path" ]; then
        printf '%s\n' "$appimage_path" > "$state_file" || {
            echo "Could not save $app_id installation state: $state_file" >&2
            return 1
        }

        echo "$app_id is already installed: $appimage_path"

        if [ "$launch" = "1" ]; then
            echo "Launching $app_id..."
            setsid "$appimage_path" >/dev/null 2>&1 < /dev/null &
        fi

        return 0
    fi

    echo "Finding the latest $app_id AppImage release..."
    appimage_url="$(jsf_github_latest_asset_url "$github_repository" "$asset_pattern")" || {
        echo "Could not contact GitHub for $app_id releases." >&2
        return 1
    }

    [ -n "$appimage_url" ] || {
        echo "No matching AppImage release was found for $app_id." >&2
        return 1
    }

    asset_name="${appimage_url##*/}"
    asset_name="${asset_name%%\?*}"
    download_path="$download_dir/$asset_name"
    partial_path="$download_path.part.$$"

    echo "Downloading $app_id..."
    curl --fail --location \
        --connect-timeout 15 \
        --max-time 600 \
        "$appimage_url" \
        --output "$partial_path" || {
        rm -f "$partial_path"
        echo "Could not download $app_id." >&2
        return 1
    }

    mv -f "$partial_path" "$download_path" || {
        rm -f "$partial_path"
        echo "Could not save the $app_id download." >&2
        return 1
    }

    chmod +x "$download_path" || {
        echo "Could not make $app_id executable." >&2
        return 1
    }

    echo "Integrating $app_id with Gear Lever..."
    flatpak run it.mijorus.gearlever --integrate "$download_path" || {
        echo "Gear Lever could not integrate $app_id." >&2
        return 1
    }

    appimage_path="$(
        find "$appimage_dir" \
            -maxdepth 1 \
            -type f \
            -iname "${app_file_key}*appimage" \
            -print -quit
    )"

    if [ -z "$appimage_path" ] && [ -f "$download_path" ]; then
        appimage_path="$download_path"
    fi

    [ -n "$appimage_path" ] && [ -f "$appimage_path" ] || {
        echo "$app_id could not be located after Gear Lever integration." >&2
        return 1
    }

    printf '%s\n' "$appimage_path" > "$state_file" || {
        echo "Could not save $app_id installation state: $state_file" >&2
        return 1
    }

    echo "$app_id is ready: $appimage_path"

    if [ "$launch" = "1" ]; then
        echo "Launching $app_id..."
        setsid "$appimage_path" >/dev/null 2>&1 < /dev/null &
    fi
}
